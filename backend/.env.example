DATABASE_URL=postgresql://postgres:password@localhost:5432/thermamind
AI_SERVICE_URL=http://localhost:8000
JWT_SECRET=replace-with-a-long-random-secret
PORT=4000
CLIENT_ORIGIN=*
SENSOR_MODE=simulation
LOG_LEVEL=info
RETENTION_CRON=0 2 * * *
SENSOR_TICK_MS=2000
STATUS_TICK_MS=5000
ENERGY_TICK_MS=10000
RECOMMENDATION_TICK_MS=300000
ALLOW_MEMORY_DATASTORE=false
